[meldritch]
kind = "performance"
version = 1

[performance]
id = "lua-apc-performance"
title = "Lua APC Performance"
bpm = 118.0
sample_rate = 48000

[ui]
[[ui.sections]]
kind = "transport"
height = 3
[[ui.sections]]
kind = "page_overview"
title = "APC: columns 1–4 drums/perc/bass/pad · bottom rows A/B/C/D"
height = 14
[[ui.sections]]
kind = "visible_controls"
title = "Faders 1–4 level · 5–8 cutoff · 9 pad resonance"
height = 7
[[ui.sections]]
kind = "status"
height = 3
[[ui.sections]]
kind = "key_hints"
height = 3
[[ui.key_hints]]
keys = "p / r / q"
label = "play-stop / rewind / quit"

[[midi_devices]]
id = "apc-mini"
name_contains = "APC mini mk2 Control"

[[tracks]]
id = "beat-drum"
synth = "synths/beat-drum.mlsynth"
patterns = ["patterns/beat-drum-a.mlpattern", "patterns/beat-drum-b.mlpattern", "patterns/beat-drum-c.mlpattern", "patterns/beat-drum-d.mlpattern"]
initial_pattern = "beat-drum-a"

[[tracks]]
id = "rhythm-drum-a"
synth = "synths/rhythm-drum-a.mlsynth"
patterns = ["patterns/rhythm-drum-a-a.mlpattern", "patterns/rhythm-drum-a-b.mlpattern", "patterns/rhythm-drum-a-c.mlpattern", "patterns/rhythm-drum-a-d.mlpattern"]
initial_pattern = "rhythm-drum-a-a"

[[tracks]]
id = "bass-a"
synth = "synths/bass-a.mlsynth"
patterns = ["patterns/bass-a-a.mlpattern", "patterns/bass-a-b.mlpattern", "patterns/bass-a-c.mlpattern", "patterns/bass-a-d.mlpattern"]
initial_pattern = "bass-a-a"

[[tracks]]
id = "pad"
synth = "synths/pad.mlsynth"
patterns = ["patterns/pad-a.mlpattern", "patterns/pad-b.mlpattern", "patterns/pad-c.mlpattern", "patterns/pad-d.mlpattern"]
initial_pattern = "pad-c"

[[lanes]]
id = "beat-drum"
label = "Beat Drum"
role = "beat_drum"
track = "beat-drum"
controls = ["beat-drum-level", "beat-drum-cutoff"]
variations = ["beat-drum-a", "beat-drum-b", "beat-drum-c", "beat-drum-d"]

[[lanes]]
id = "rhythm-drum-a"
label = "Percussion"
role = "rhythm_drum"
track = "rhythm-drum-a"
controls = ["rhythm-drum-a-level", "rhythm-drum-a-cutoff"]
variations = ["rhythm-drum-a-a", "rhythm-drum-a-b", "rhythm-drum-a-c", "rhythm-drum-a-d"]

[[lanes]]
id = "bass-a"
label = "Bass"
role = "monophonic_synth"
track = "bass-a"
controls = ["bass-a-level", "bass-a-cutoff"]
variations = ["bass-a-a", "bass-a-b", "bass-a-c", "bass-a-d"]

[[lanes]]
id = "pad"
label = "Pad"
role = "polyphonic_synth"
track = "pad"
controls = ["pad-level", "pad-cutoff", "pad-resonance"]
variations = ["pad-a", "pad-b", "pad-c", "pad-d"]

[[pages]]
id = "main"
label = "APC Groove"

[[pages.strips]]
strip = 1
lane = "beat-drum"
controls = ["beat-drum-level", "beat-drum-cutoff"]

[[pages.strips]]
strip = 2
lane = "rhythm-drum-a"
controls = ["rhythm-drum-a-level", "rhythm-drum-a-cutoff"]

[[pages.strips]]
strip = 3
lane = "bass-a"
